# Copy to .env and adjust.

# Django
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1,api
SESSION_DAYS=30

# The Next.js site allowed to call this API
FRONTEND_ORIGIN=http://localhost:3000

# Database. docker-compose.yml uses the POSTGRES_* values and points the api container at the db service;
# DATABASE_URL is for running Django directly on your machine.
POSTGRES_USER=simbatech
POSTGRES_PASSWORD=simbatech
POSTGRES_DB=simbatech
POSTGRES_PORT=5432
DATABASE_URL=postgresql://simbatech:simbatech@localhost:5432/simbatech

# Port the API container is published on
API_PORT=8000

# ── Optional integrations (leave empty for development mode) ──
# Chapa payments (Telebirr, CBE Birr, cards). Without a key, payments are simulated as paid.
CHAPA_SECRET_KEY=
CHAPA_WEBHOOK_SECRET=
# Public URL of this API, used for the payment return / webhook URLs and the Google redirect
API_PUBLIC_URL=http://localhost:8000
# Google sign-in. Without these the "Continue with Google" button is disabled.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# SMS one-time codes: console (code goes to the log and, while DEBUG=1, back to the site) or africastalking
SMS_BACKEND=console
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=
# Password-reset emails: SMTP when EMAIL_HOST is set, otherwise printed to the log
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=Simbatech <no-reply@simbatech.et>
# Password for the seeded admin account (admin@simbatech.et)
ADMIN_PASSWORD=admin12345
